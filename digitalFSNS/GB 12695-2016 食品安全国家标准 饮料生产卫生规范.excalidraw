ughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"wjgz2l4y0ta4k6pk7y54w","type":"rectangle","x":478.4,"y":13687.5,"width":535.6,"height":95,"angle":0,"strokeColor":"#283593","backgroundColor":"#E8EAF6","fillStyle":"solid","strokeWidth":2.7,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"aamu3juhcorx6my11xf86c"},{"type":"arrow","id":"cowkvz3x67emgotrxodsan"},{"type":"text","id":"qb1h0hjku4acsnnwnkx174"}],"version":2,"versionNonce":1332638,"index":"b1h","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"link":null,"locked":false},{"id":"qb1h0hjku4acsnnwnkx174","type":"text","x":528.4,"y":13712.5,"width":435.6,"height":45,"angle":0,"strokeColor":"#1A237E","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"8.3.1 清洁和消毒","text":"8.3.1 清洁和消毒","fontSize":36,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"wjgz2l4y0ta4k6pk7y54w","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":2050743106,"index":"b1i","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"aamu3juhcorx6my11xf86c","type":"arrow","x":358.4,"y":10150,"width":120,"height":3585,"angle":0,"strokeColor":"#283593","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.8,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[60,0],[60,3585],[120,3585]],"startBinding":{"elementId":"cb3o9c41u2e1yx1lic1cfo","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"wjgz2l4y0ta4k6pk7y54w","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":1014231518,"index":"b1j","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"62r5o0s90uchliqzext0o","type":"embeddable","x":1213.2,"y":13535,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"cowkvz3x67emgotrxodsan"},{"type":"text","id":"ztgvzh21uzow86ohzt5b"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"8.3.1.1 清洁消毒方法应安全、卫生、有效。"},{"type":"hardbreak"},{"type":"text","text":"8.3.1.2 清洁作业区生产前应启动空气净化系统，对车间内空气进行净化。"},{"type":"hardbreak"},{"type":"text","text":"8.3.1.3 应保证清洁人员的数量并根据需要明确每个人的责任，所有的清洁人员均应接受良好的培训，认识污染的危害性和防止污染的重要性，确保生产车间达到卫生要求。"},{"type":"hardbreak"},{"type":"text","text":"8.3.1.4 用于不同清洁区内的清洁工具应有明确标识，不得混用。"},{"type":"hardbreak"},{"type":"text","text":"8.3.1.5 包装容器、材料在使用前应清洁或消毒，如果采用吹瓶、灌装、封盖(封口)一体设备，且设备自带空瓶或瓶胚除尘和瓶盖消毒功能，可不再进行空瓶和瓶盖清洗消毒。"}]}},"version":2,"versionNonce":1784881922,"index":"b1k","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"ztgvzh21uzow86ohzt5b","type":"text","x":1343.8,"y":13717.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"62r5o0s90uchliqzext0o","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":991299102,"index":"b1l","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"cowkvz3x67emgotrxodsan","type":"arrow","x":1014,"y":13735,"width":199.20000000000005,"height":0,"angle":
ter","verticalAlign":"middle","containerId":"q5m13pp5dvbofpv7tb9eda","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":172906398,"index":"b1x","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"px0vi91glbrx03bdasct5n","type":"arrow","x":358.4,"y":10150,"width":120,"height":4905,"angle":0,"strokeColor":"#283593","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.8,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[60,0],[60,4905],[120,4905]],"startBinding":{"elementId":"cb3o9c41u2e1yx1lic1cfo","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"q5m13pp5dvbofpv7tb9eda","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":1243281730,"index":"b1y","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"hq6mvxvmvr8vfzu4ms9iqo","type":"embeddable","x":1213.2,"y":14855,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"wo8n9avivc1z8w53apveq"},{"type":"text","id":"dj2ipr2560k3rcp6eli5n6"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"8.4.1 使用的洗涤剂、消毒剂应符合国家相关标准和规定。"},{"type":"hardbreak"},{"type":"text","text":"8.4.2 生产车间不应在生产过程中使用各类杀虫剂。"},{"type":"hardbreak"},{"type":"text","text":"8.4.3 杀虫剂、清洁剂、消毒剂等化学品应在其外包装有明显警示标识，并存放于专用仓库内，设专人保管。"},{"type":"hardbreak"},{"type":"text","text":"8.4.4 杀虫剂、清洁剂、消毒剂等化学品的采购及使用应有详细记录，包括使用人、使用目的、使用区域、使用量、使用及购买时间、配制浓度等。"}]}},"version":2,"versionNonce":874361822,"index":"b1z","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977
pe":"text","x":1343.8,"y":12732.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"bhyu85c7ylfd8o7jae2oqp","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":1922946242,"index":"b1W","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"v5orr1xehfqr7qxlq7j7","type":"arrow","x":895.2,"y":12750,"width":318,"height":0,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[318,0]],"startBinding":{"elementId":"jgkq8ks44x6tq71knslab","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"bhyu85c7ylfd8o7jae2oqp","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":1852330078,"index":"b1X","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"l62ujlie8t1lurzuvxqkb","type":"rectangle","x":478.4,"y":13142.5,"width":575.2,"height":95,"angle":0,"strokeColor":"#283593","backgroundColor":"#E8EAF6","fillStyle":"solid","strokeWidth":2.7,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"hnnvxzha4iehwgesrebw0b"},{"type":"arrow","id":"0k3l2ghfz6woku2ebe4jqmj"},{"type":"text","id":"h0idaw7b4j4wjd5xnkhj2o"}],"version":2,"versionNonce":1196027010,"index":"b1Y","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"link":null,"locked":false},{"id":"h0idaw7b4j4wjd5xnkhj2o","type":"text","x":528.4,"y":13167.5,"width":475.20000000000005,"height":45,"angle":0,"strokeColor":"#1A237E","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"8.2 产品污染风险控制","text":"8.2 产品污染风险控制","fontSize":36,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"l62ujlie8t1lurzuvxqkb","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":469406878,"index":"b1Z","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"hnnvxzha4iehwgesrebw0b","type":"arrow","x":358.4,"y":10150,"width":120,"height":3040,"angle":0,"strokeColor":"#283593","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.8,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[60,0],[60,3040],[120,3040]],"startBinding":{"elementId":"cb3o9c41u2e1yx1lic1cfo","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"l62ujlie8t1lurzuvxqkb","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":639437890,"index":"b1a","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"bgh2l9gdrbgrz832jixrr","type":"embeddable","x":1213.2,"y":12990,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"0k3l2ghfz6woku2ebe4jqmj"},{"type":"text","id":"h4sm67yror61j34gp844ta"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"8.2.1 应定期检测食品加工用水水质。饮料用水需脱氯时，应定期检验，确保游离余氯去除充分。"},{"type":"hardbreak"},{"type":"text","text":"8.2.2 有水处理工艺的，应规定水处理过滤装置的清洗更换要求，制定处理后水的控制指标并监测记录。"},{"type":"hardbreak"},{"type":"text","text":"8.2.3 有调配工艺的，需复核确认，防止投料种类和数量有误。"},{"type":"hardbreak"},{"type":"text","text":"8.2.4 调配使用的食品工业用浓缩液（汁、浆）、原汁、糖液、水及其他配料和食品添加剂，使用前应确认其感官性状无异常。"},{"type":"hardbreak"},{"type":"text","text":"8.2.5 溶解后的糖浆应过滤去除杂质，调好的糖浆应尽快使用。"},{"type":"hardbreak"},{"type":"text","text":"8.2.6 半成品的贮存应严格控制温度和时间，配制好的半成品应尽快使用。因故延缓生产时，应对已调配好的半成品及时作有效处理，防止污染或腐败变质，恢复生产时应对其进行检验，不符合标准的应予以废弃。"},{"type":"hardbreak"},{"type":"text","text":"8.2.7 杀菌工序应有相应的杀菌参数（如温度、时间、压力等）的记录或图表，并定时检查是否达到规定要求。"},{"type":"hardbreak"},{"type":"text","text":"8.2.8 生产时应确保产品封口的密闭性。"}]}},"version":2,"versionNonce":523915486,"index":"b1b","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"h4sm67yror61j34gp844ta","type":"text","x":1343.8,"y":13172.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"bgh2l9gdrbgrz832jixrr","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":1156985858,"index":"b1c","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"0k3l2ghfz6woku2ebe4jqmj","type":"arrow","x":1053.6,"y":13190,"width":159.60000000000014,"height":0,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[159.60000000000014,0]],"startBinding":{"elementId":"l62ujlie8t1lurzuvxqkb","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"bgh2l9gdrbgrz832jixrr","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":140460
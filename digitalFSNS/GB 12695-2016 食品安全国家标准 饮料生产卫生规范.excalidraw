r":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"l6yrnqqcmsg6tqiggvrr3n","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":1939935006,"index":"b2v","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"8kpvxa90p9aqpmb4xsjvn","type":"arrow","x":974.4,"y":19340,"width":238.80000000000007,"height":220,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[119.39999999999998,0],[119.39999999999998,220],[238.80000000000007,220]],"startBinding":{"elementId":"diurwsfi1wmnp62bahpod","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"l6yrnqqcmsg6tqiggvrr3n","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":1578203586,"index":"b2w","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"3a4qk2erysbypgl64i7us","type":"embeddable","x":1213.2,"y":19800,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"ds8zr04qiwizuq4oboty5"},{"type":"text","id":"rmtt9uvvp5fri440rglh"}],"link":"demo.md","customData":{"jsonValue":{"type":"html_block","attrs":{"language":"html-preview"},"content":[{"type":"text","text":"<table>\n<tr>\n<td colspan=\"2\">监控项目</td>\n<td>建议取样点a</td>\n<td>建议监控微生物b</td>\n<td>建议监控频率c</td>\n<td>建议监控指标限值d</td>\n</tr>\n<tr>\n<td rowspan=\"3\">环境的微生物监控</td>\n<td>食品接触表面</td>\n<td>灌装设备的灌装头(静态)</td>\n<td>菌落总数、大肠菌群</td>\n<td>每周、每两周或每月</td>\n<td>结合生产实际情况确定监控指标限值</td>\n</tr>\n<tr>\n<td>与食品或食品接触表面邻近的接触表面</td>\n<td>-</td>\n<td>-</td>\n<td>-</td>\n<td>-</td>\n</tr>\n<tr>\n<td>加工区域内的环境空气</td>\n<td>清洁作业区[固体饮料、食品工业用浓缩液(汁、浆)、饮料浓浆除外]</td>\n<td>沉降菌(静态)e</td>\n<td>每周、每两周或每月</td>\n<td>≤10个/(φ90mm·0.5h)</td>\n</tr>\n<tr>\n<td colspan=\"2\">过程产品的微生物监控</td>\n<td>清洗、消毒后包装容器、材料(瓶、桶、盖)[吹瓶、灌装、封盖(封口)一体设备且自带空瓶或瓶胚除尘和瓶盖消毒功能、后杀菌工艺、无菌袋包装除外]</td>\n<td>菌落总数、大肠菌群</td>\n<td>每周、每两周或每月</td>\n<td>结合生产实际情况确定监控指标限值</td>\n</tr>\n<tr>\n<td colspan=\"6\">a 可根据食品特性以及加工过程实际情况选择取样点。b 可根据需要选择一个或多个指示菌实施监控。c 可根据具体取样点的风险确定监控频率。d 可根据产品品种特性及生产实际情况确定监控指标限值。e 沉降菌按GB/T 18204.3中自然沉降法测定。</td>\n</tr>\n</table>"}]}},"version":2,"versionNonce":1630370654,"index":"b2x","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"rmtt9uvvp5fri440rglh","type":"text","x":1328.4,"y":19982.5,"width":369.6,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[html_block]","text":"[html_block]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"3a4qk2erysbypgl64i7us","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":788590978,"index":"b2y","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"ds8zr04qiwizuq4oboty5","type":"arrow","x":974.4,"y":19340,"width":238.80000000000007,"height":660,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[119.39999999999998,0],[119.39999999999998,660],[238.80000000000007,660]],"startBinding":{"elementId":"diurwsfi1wmnp62bahpod","focus":0.5,"gap":4,"fixedPoint":[1,0.5
1,"version":2,"versionNonce":1860304898,"index":"b04","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"3nljrjp09s7zt0kasu0ev","type":"arrow","x":358.4,"y":10150,"width":120,"height":3920,"angle":0,"strokeColor":"#283593","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.8,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[60,0],[60,-3920],[120,-3920]],"startBinding":{"elementId":"cb3o9c41u2e1yx1lic1cfo","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"kn09pjphrbrw1t0if6548","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":1748990238,"index":"b05","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"75i0rgq5bt7309umwmh9p9","type":"embeddable","x":1213.2,"y":6030,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"tspxmi4dulncdy2jlpkm"},{"type":"text","id":"3oy06dryuhr7ojsa9sgyp"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"5.2.1.1 必要时应配备储水设备（如储水槽、储水塔、储水池等），储水设备应符合国家相关标准或规定，以无毒、无异味、不导致水质污染的材料构筑，有防污染设施，并定期清洗消毒。"},{"type":"hardbreak"},{"type":"text","text":"5.2.1.2 供水设施出入口应增设安全卫生设施，防止异物进入。"}]}},"version":2,"versionNonce":1483124674,"index":"b06","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"3oy06dryuhr7ojsa9sgyp","type":"text","x":1343.8,"y":6212.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"
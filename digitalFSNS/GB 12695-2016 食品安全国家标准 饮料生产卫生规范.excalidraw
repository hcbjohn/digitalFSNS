d1y7vtpjhbthmuuk"},{"type":"text","id":"pot3xmc36yc9mmb7087n8"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"4.1 应符合GB14881—2013中第4章的相关规定。"}]}},"version":2,"versionNonce":861697310,"index":"aZ","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"pot3xmc36yc9mmb7087n8","type":"text","x":1343.8,"y":2922.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"476bw0zb9lp7xmbwo9knm","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":380072898,"index":"aa","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"8fhw78d1y7vtpjhbthmuuk","type":"arrow","x":855.5999999999999,"y":4040,"width":357.60000000000014,"height":1100,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[178.80000000000018,0],[178.80000000000018,-1100],[357.60000000000014,-1100]],"startBinding":{"elementId":"7hr5mazvu2voum0fls4tak","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"476bw0zb9lp7xmbwo9knm","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":546054494,"index":"ab","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"eqtwtwv1hyevwdwjj3xq","type":"embeddable","x":1213.2,"y":3180,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"1axhy9i1j7kb74qlbigsc8"},{"type":"text","id":"2d9r21m57pqutdu58d77z"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"4.2厂房和车间的设计通常划分为一般作业区、准清洁作业区、清洁作业区。各区之间应有效隔离，防止交叉污染。一般作业区通常包括原料处理区、仓库、外包装区等；准清洁作业区通常包括杀菌区、配料区、包装容器清洗消毒区等；清洁作业区通常包括液体饮料的灌装防护区或固体饮料的内包装区等。具体划分时根据产品特点、生产工艺及生产过程对清洁程度的要求设定。"}]}},"version":2,"versionNonce":382184322,"index":"ac","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"2d9r21m57pqutdu58d77z","type":"text","x":1343.8,"y":3362.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"eqtwtwv1hyevwdwjj3xq","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":1534870942,"index":"ad","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"1axhy9i1j7kb74qlbigsc8","type":"arrow","x":855.5999999999999,"y":4040,"width":357.60000000000014,"height":660,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[178.80000000000018,0],[178.80000000000018,-660],[357.60000000000014,-660]],"startBinding":{"elementId":"7hr5mazvu2voum0fls4tak","focus":0.5,"gap":4,"fixedPoint":[1,0.5001]},"endBinding":{"elementId":"eqtwtwv1hyevwdwjj3xq","focus":0.5,"gap":4,"fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"version":2,"versionNonce":1569385282,"index":"ae","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false,"lastCommittedPoint":null},{"id":"vj6j225bbpjyrqvkzhyywc","type":"embeddable","x":1213.2,"y":3620,"width":600,"height":400,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"#E8F5E9","fillStyle":"solid","strokeWidth":2.4,"strokeStyle":"solid","opacity":100,"roundness":{"type":3},"boundElements":[{"type":"arrow","id":"mwfssavwrjuevikmm6uid"},{"type":"text","id":"fxegfqn5dzfpib65rvvbbp"}],"link":"demo.md","customData":{"jsonValue":{"type":"paragraph","content":[{"type":"text","text":"4.3 液体饮料企业一般应设置水处理区、配料区、灌装防护区、包装区、原辅材料及包装材料仓库、成品仓库、检测实验室等，生产食品工业用浓缩液(汁、浆)的企业还应设置原料清洗区（与后续工序有效隔离）。固体饮料企业一般应设置配料区、干燥脱水区/混合区、包装区、原辅材料及包装材料仓库、成品仓库、检测实验室等。如使用周转的容器生产，还应单独设立周转容器检查、预洗间。"}]}},"version":2,"versionNonce":1163780574,"index":"af","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"updated":1763977364290,"locked":false},{"id":"fxegfqn5dzfpib65rvvbbp","type":"text","x":1343.8,"y":3802.5,"width":338.80000000000007,"height":35,"angle":0,"strokeColor":"#1B5E20","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","opacity":100,"roundness":null,"originalText":"[paragraph]","text":"[paragraph]","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"vj6j225bbpjyrqvkzhyywc","autoResize":true,"lineHeight":1.25,"lineCount":1,"version":2,"versionNonce":827339522,"index":"ag","isDeleted":false,"roughness":1,"seed":1,"groupIds":[],"frameId":null,"boundElements":[],"updated":1763977364290,"link":null,"locked":false},{"id":"mwfssavwrjuevikmm6uid","type":"arrow","x":855.5999999999999,"y":4040,"width":357.60000000000014,"height":220,"angle":0,"strokeColor":"#2E7D32","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.6,"strokeStyle":"solid","opacity":100,"roundness":null,"points":[[0,0],[178.80000000000018,0],[178.80000000000018,-220],[357.60000000000014,-220]],"startBi